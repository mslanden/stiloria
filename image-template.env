# The image's name and metadata, read by the Justfile. The build labels the
# image with them (org.opencontainers.image.* and io.artifacthub.package.*).

# The image is ghcr.io/$REPO_ORGANIZATION/$IMAGE_NAME; the workflows assume the
# same name as this GitHub repo (build-disk.yml's IMAGE_NAME).
IMAGE_NAME=stiloria
REPO_ORGANIZATION="mslanden"

IMAGE_DESC="Stiloria: a Bazzite-based Linux for gaming and AI"
IMAGE_KEYWORDS="bootc,bazzite,gaming,ai,linux"

# The helmet logo, from main, so the URL stays valid as the image changes.
IMAGE_LOGO_URL="https://raw.githubusercontent.com/mslanden/stiloria/main/branding/stiloria-logo.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
