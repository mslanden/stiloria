#!/usr/bin/bash
# Install the apps in /usr/share/stiloria/flatpaks that this machine has never
# been offered. Remembering what was offered, rather than what is installed,
# means an app the user removed stays removed.
set -euo pipefail

list=/usr/share/stiloria/flatpaks
offered=/var/lib/stiloria/flatpaks-offered
mkdir -p "$(dirname "$offered")"
touch "$offered"

new=()
while read -r app; do
    [[ -z $app || $app == \#* ]] && continue
    grep -qxF "$app" "$offered" || new+=("$app")
done < "$list"

if ((${#new[@]} == 0)); then
    echo "No new Stiloria apps to install."
    exit 0
fi

# Bazzite's flatpak manager sets up the Flathub remote; make sure it exists anyway.
flatpak remote-add --if-not-exists --system flathub /etc/flatpak/remotes.d/flathub.flatpakrepo || :
# The apps Flathub has. Without it (no network yet) nothing is recorded, and
# the service tries again.
available=$(flatpak remote-ls --system --app --columns=application flathub)

# One app at a time, so one that fails doesn't hold back the others. An app
# Flathub doesn't have (renamed, retired, or a typo in the list) would fail
# every time, so it counts as offered; any other failure is tried again.
failed=()
for app in "${new[@]}"; do
    if ! grep -qxF "$app" <<< "$available"; then
        echo "Not on Flathub, skipped: $app"
    elif flatpak install --system --noninteractive --or-update flathub "$app"; then
        echo "Installed: $app"
    else
        failed+=("$app")
        continue
    fi
    echo "$app" >> "$offered"
done
if ((${#failed[@]})); then
    echo "Failed, to be tried again: ${failed[*]}" >&2
    exit 1
fi
