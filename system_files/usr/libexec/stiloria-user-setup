#!/usr/bin/bash
# Run at each Plasma login. Each numbered step runs once per user, so someone
# switching from Bazzite gets Stiloria's look, and whatever they change
# afterwards is never overwritten. To roll a new default out to everyone once,
# add a step with the next number.
state="${XDG_STATE_HOME:-$HOME/.local/state}/stiloria/user-setup"
done_steps=0
[[ -f $state ]] && done_steps=$(cat "$state")
done_with() {
    mkdir -p "$(dirname "$state")"
    echo "$1" > "$state"
}

# Plasma may still be starting when autostart runs; wait for it a little, and
# if it never answers, try again at the next login.
for _ in $(seq 1 20); do
    qdbus org.kde.plasmashell /PlasmaShell >/dev/null 2>&1 && ready=1 && break
    sleep 3
done
[[ -n ${ready:-} ]] || exit 0

# 1: wallpaper and lock screen
if ((done_steps < 1)); then
    wallpaper=/usr/share/wallpapers/Stiloria-Helmet/contents/images/3840x2160.jpg
    plasma-apply-wallpaperimage "$wallpaper" >/dev/null 2>&1 || exit 0
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image "file://$wallpaper"
    kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key PreviewImage "file://$wallpaper"
    done_with 1
fi

# 2: the start-menu button shows the Stiloria helmet
if ((done_steps < 2)); then
    qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript '
        panels().forEach(function (panel) {
            panel.widgets("org.kde.plasma.kickoff").forEach(function (launcher) {
                launcher.currentConfigGroup = ["General"];
                launcher.writeConfig("icon", "stiloria-start");
                launcher.reloadConfig();
            });
        });' >/dev/null || exit 0
    done_with 2
fi

# 3: Stiloria's colors, with the Breeze Plasma style so the panel and menus
# follow them (Vapor's Plasma style has fixed colors)
if ((done_steps < 3)); then
    plasma-apply-colorscheme Stiloria >/dev/null 2>&1 || exit 0
    plasma-apply-desktoptheme default >/dev/null 2>&1 || exit 0
    done_with 3
fi

# 4: Stiloria Day and Night. The look follows the time of day with Plasma's
# automatic theme switching, starting with whichever fits now; the wallpaper and
# lock screen name the Stiloria Helmet package; and the bottom panel floats. The
# panel's layout and apps are left as they are.
if ((done_steps < 4)); then
    kwriteconfig6 --file kdeglobals --group KDE --key DefaultLightLookAndFeel com.stiloria.day.desktop
    kwriteconfig6 --file kdeglobals --group KDE --key DefaultDarkLookAndFeel com.stiloria.night.desktop
    kwriteconfig6 --file kdeglobals --group KDE --key AutomaticLookAndFeel true
    hour=$(date +%-H)
    look=com.stiloria.night.desktop
    ((hour >= 7 && hour < 19)) && look=com.stiloria.day.desktop
    plasma-apply-lookandfeel -a "$look" >/dev/null 2>&1 || exit 0
    plasma-apply-wallpaperimage /usr/share/wallpapers/Stiloria-Helmet >/dev/null 2>&1 || exit 0
    for key in Image PreviewImage; do
        kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key "$key" /usr/share/wallpapers/Stiloria-Helmet/
    done
    qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript '
        panels().forEach(function (panel) {
            if (panel.location == "bottom") panel.floating = true;
        });' >/dev/null || exit 0
    done_with 4
fi

# 5: the greeting at the top left of the desktop (Stiloria Greeting). Until the
# widget is installed this step waits, trying again at the next login.
if ((done_steps < 5)); then
    [[ -d /usr/share/plasma/plasmoids/com.stiloria.greeting ]] || exit 0
    qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript '
        var desktop = desktopForScreen(0);
        if (desktop.widgets("com.stiloria.greeting").length === 0) {
            desktop.addWidget("com.stiloria.greeting", 96, 64, 640, 304);
        }' >/dev/null || exit 0
    done_with 5
fi

# 6: the Stiloria Helmet is the default wallpaper again, in place of the sky
# city that step 4 gave everyone. Desktops and the lock screen still showing
# the sky city move to the helmet; a wallpaper picked since stays. A greeting
# on a desktop that shows the helmet is set to ivory text, since the helmet's
# wall stays dark while the day colors are on.
if ((done_steps < 6)); then
    qdbus org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript '
        var skyCity = /^(file:\/\/)?\/usr\/share\/wallpapers\/Stiloria(\/|\/contents\/images\/3840x2160\.jpg)?$/;
        var helmet = /^(file:\/\/)?\/usr\/share\/wallpapers\/Stiloria-Helmet(\/|\/contents\/images\/3840x2160\.jpg)?$/;
        desktops().forEach(function (desktop) {
            if (desktop.wallpaperPlugin != "org.kde.image") return;
            desktop.currentConfigGroup = ["Wallpaper", "org.kde.image", "General"];
            var image = String(desktop.readConfig("Image", ""));
            if (skyCity.test(image)) {
                image = "/usr/share/wallpapers/Stiloria-Helmet/";
                desktop.writeConfig("Image", image);
                desktop.reloadConfig();
            }
            if (!helmet.test(image)) return;
            desktop.widgets("com.stiloria.greeting").forEach(function (greeting) {
                greeting.currentConfigGroup = ["General"];
                greeting.writeConfig("textColor", "light");
                greeting.reloadConfig();
            });
        });' >/dev/null || exit 0
    sky_city='^(file://)?/usr/share/wallpapers/Stiloria(/|/contents/images/3840x2160\.jpg)?$'
    lock_image=$(kreadconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key Image)
    if [[ $lock_image =~ $sky_city ]]; then
        for key in Image PreviewImage; do
            kwriteconfig6 --file kscreenlockerrc --group Greeter --group Wallpaper --group org.kde.image --group General --key "$key" /usr/share/wallpapers/Stiloria-Helmet/
        done
    fi
    done_with 6
fi
