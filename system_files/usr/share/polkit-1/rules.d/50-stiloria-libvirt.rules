// virt-manager and virsh manage the system's VMs (qemu:///system) without a
// password for an administrator (the wheel group) at the machine, as Fedora's
// own rule (50-libvirt.rules) allows the libvirt group, so nobody has to be
// added to that group first.
polkit.addRule(function (action, subject) {
    if (action.id == "org.libvirt.unix.manage" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
